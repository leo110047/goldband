#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
goldband_root="$(cd "$hook_dir/.." && pwd)"
if [ -f "$hook_dir/.goldband-source" ]; then
  IFS= read -r installed_source < "$hook_dir/.goldband-source" || true
  if [ -n "${installed_source:-}" ]; then
    goldband_root="$installed_source"
  fi
fi
project_hook_lib="$hook_dir/lib/project-hook.sh"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

[ -f "$project_hook_lib" ] && source "$project_hook_lib"

block_managed_worktree_commit() {
  local git_dir marker
  git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
  [ -n "$git_dir" ] || return 0
  case "$git_dir" in
    /*) ;;
    *) git_dir="$repo_root/$git_dir" ;;
  esac
  marker="$git_dir/goldband-managed-worktree.json"
  [ -f "$marker" ] || return 0
  echo "[goldband] BLOCKED: managed worktrees cannot commit directly." >&2
  echo "[goldband] Exit the managed shell and run: goldband worktree finish <name> -m \"<message>\"" >&2
  return 1
}

run_project_pre_commit() {
  declare -F goldband_chain_hooks >/dev/null || return 0
  goldband_chain_hooks "$hook_dir" "pre-commit"
}

run_goldband_pre_commit() {
  if [ "${GOLDBAND_STYLE_GATE:-1}" = "0" ]; then
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/goldband"
    mkdir -p "$state_dir"
    printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$repo_root" "GOLDBAND_STYLE_GATE=0" >> "$state_dir/style-gate-bypass.log"
    echo "[goldband] WARNING: style gate bypassed with GOLDBAND_STYLE_GATE=0" >&2
    return 0
  fi

  if [ -f "$repo_root/.goldband-no-style-gate" ]; then
    echo "[goldband] style gate skipped: .goldband-no-style-gate exists" >&2
    return 0
  fi

  gate_script="${GOLDBAND_STYLE_GATE_SCRIPT:-$goldband_root/scripts/check-code-style.mjs}"
  if [ ! -f "$gate_script" ]; then
    echo "[goldband] WARNING: style gate script missing, allowing commit: $gate_script" >&2
    return 0
  fi

  if ! command -v node >/dev/null 2>&1; then
    echo "[goldband] WARNING: node not found; style gate skipped" >&2
    return 0
  fi

  node "$gate_script" --staged
}

block_managed_worktree_commit
run_goldband_pre_commit
run_project_pre_commit

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "\u5b89\u88dd\u5f8c\u8acb\u5c07\u6b64\u6a94\u6848\u5167\u5bb9\u5408\u4f75\u5230 ~/.claude/settings.json\uff0c\u4e26\u5c07 ${HOOKS_DIR} \u66ff\u63db\u70ba\u5be6\u969b\u8def\u5f91",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git stash*)",
      "Bash(git remote *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cd)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(test *)",
      "Bash([ *)",
      "Bash(jq *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(basename *)",
      "Bash(dirname *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(chmod 777 *)",
      "Bash(> /dev/*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ${CLAUDE_DIR}/statusline-command.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOOKS_DIR}/scripts/hooks/skill-activation-suggestions.js\""
          }
        ],
        "description": "Prompt-time skill suggestions + prompt-trigger telemetry"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOOKS_DIR}/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Unified router (blocking policies: careful-mode/freeze-mode/secrets/dev-server/doc-file)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOOKS_DIR}/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Unified router (context monitor + console warnings)"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOOKS_DIR}/scripts/hooks/post-edit-worker.js\" --task format",
            "async": true
          }
        ],
        "description": "Native async format worker with debounce"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOOKS_DIR}/scripts/hooks/post-edit-worker.js\" --task typecheck",
            "async": true
          }
        ],
        "description": "Native async typecheck worker with debounce"
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOOKS_DIR}/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Actionable Goldband review failure guidance"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOOKS_DIR}/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Unified router (cross-review gate + mode cleanup)"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "general-purpose",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "The subagent completion claims for its assigned task are supported by evidence already in the conversation. Evaluate only that condition, not whether the subagent performed this hook review. Session metadata and transcript paths are identifiers, not additional tasks or files the subagent must read. Arithmetic reasoning is sufficient for arithmetic; tests are not required for read-only analysis or trivial text edits. Previously verified evidence remains valid when the relevant code, configuration, and environment are unchanged. Return only JSON: {\"ok\": true} if claims are supported or no completion is claimed; otherwise {\"ok\": false, \"reason\": \"Name the unsupported task completion claim and the specific missing evidence.\"}. Hook context: $ARGUMENTS",
            "timeout": 30
          }
        ],
        "description": "Lightweight spec review for general-purpose subagent output"
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOOKS_DIR}/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Unified router notification handling"
      }
    ]
  }
}

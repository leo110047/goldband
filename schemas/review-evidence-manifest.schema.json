{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldband.dev/schemas/review-evidence-manifest.schema.json",
  "title": "Goldband Review Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "behaviorMatrix", "providers", "authorizations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "behaviorMatrix": { "$ref": "review-behavior-matrix.schema.json" },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "kind", "lifecycle", "cellIds", "applicability", "executionContext", "operations"],
        "allOf": [
          {
            "if": { "properties": { "executionContext": { "properties": { "runner": { "const": "local-host" } }, "required": ["runner"] } }, "required": ["executionContext"] },
            "then": {
              "properties": {
                "id": { "enum": ["review-evidence-tests", "work-map-review-tests", "installed-runtime-tests"] },
                "kind": { "const": "project-gate" },
                "lifecycle": { "const": "persistent" },
                "executionContext": { "properties": { "lane": { "const": "goldband-local-review-host" } } },
                "operations": { "maxItems": 1, "items": { "properties": {
                  "network": { "const": "host" }, "target": { "const": "candidate" },
                  "expectedExit": { "const": "zero" }, "evidenceLevel": { "const": "local" }
                } } }
              }
            },
            "else": { "properties": { "operations": { "items": { "properties": { "network": { "not": { "const": "host" } } } } } } }
          },
          {
            "if": { "properties": { "lifecycle": { "const": "transition" } }, "required": ["lifecycle"] },
            "then": { "required": ["transitionBinding"] },
            "else": { "not": { "required": ["transitionBinding"] } }
          },
          {
            "if": { "properties": { "kind": { "const": "property-fuzz" } }, "required": ["kind"] },
            "then": {
              "properties": {
                "operations": {
                  "items": { "required": ["seed", "iterations"] }
                }
              }
            }
          }
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "owner": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["regression", "static", "project-gate", "property-fuzz", "runtime-integration"] },
          "lifecycle": { "enum": ["persistent", "transition"] },
          "cellIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
          },
          "applicability": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "pathPrefixes"],
                "properties": {
                  "kind": { "const": "paths" },
                  "pathPrefixes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?=\\S(?:.*\\S)?$)[^/]+(?:/[^/]+)*$"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "reason"],
                "properties": {
                  "kind": { "const": "global" },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "executionContext": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["sandboxOwner", "runner"],
                "properties": {
                  "sandboxOwner": { "const": "review-runtime" },
                  "runner": { "const": "sealed" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["sandboxOwner", "runner", "lane"],
                "properties": {
                  "sandboxOwner": { "const": "provider" },
                  "runner": { "enum": ["host-seatbelt", "github-actions", "local-host"] },
                  "lane": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "transitionBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "baseDigest", "candidateDigest", "scopeDigest", "operationContractDigest"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "baseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "candidateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "scopeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "operationContractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "target", "argv", "expectedExit", "timeoutMs", "maxOutputBytes", "network", "evidenceLevel"],
              "allOf": [
                {
                  "if": { "properties": { "network": { "const": "authorized" } }, "required": ["network"] },
                  "then": { "required": ["authorizationId"] },
                  "else": { "not": { "required": ["authorizationId"] } }
                },
                {
                  "if": {
                    "properties": {
                      "evidenceLevel": { "enum": ["live-provider", "device-platform", "production-readback"] }
                    },
                    "required": ["evidenceLevel"]
                  },
                  "then": {
                    "properties": { "network": { "const": "authorized" } },
                    "required": ["network", "authorizationId"]
                  }
                },
                {
                  "if": { "properties": { "expectedExit": { "const": "nonzero" } }, "required": ["expectedExit"] },
                  "then": { "required": ["expectedExitCode"] },
                  "else": { "not": { "required": ["expectedExitCode"] } }
                },
                {
                  "if": {
                    "properties": { "argv": { "prefixItems": [{ "pattern": "^[Pp][Yy][Tt][Hh][Oo][Nn](?:[0-9]+(?:\\.[0-9]+)*)?(?:[dDtTwW])?(?:\\.[Ee][Xx][Ee])?$" }] } },
                    "required": ["argv"]
                  },
                  "then": { "required": ["pythonRuntime"] }
                },
                {
                  "if": { "required": ["pythonRuntime"] },
                  "then": {
                    "properties": {
                      "network": { "const": "deny" },
                      "argv": {
                        "prefixItems": [{ "const": "python3.14" }]
                      },
                      "requiredSystemTools": {
                        "items": { "not": { "enum": ["python3.14", "uv"] } }
                      }
                    }
                  }
                }
              ],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
                "target": { "enum": ["base", "candidate"] },
                "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "expectedExit": { "enum": ["zero", "nonzero"] },
                "expectedExitCode": { "type": "integer", "minimum": 1, "maximum": 255 },
                "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 900000 },
                "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
                "network": { "enum": ["deny", "authorized", "host"] },
                "authorizationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
                "evidenceLevel": { "enum": ["fixture", "local", "sandboxed-service", "live-provider", "device-platform", "production-readback"] },
                "requiredSystemTools": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$", "not": { "pattern": "^[Pp][Yy][Tt][Hh][Oo][Nn](?:[0-9]+(?:\\.[0-9]+)*)?(?:[dDtTwW])?(?:\\.[Ee][Xx][Ee])?$" } }
                },
                "pythonRuntime": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["interpreter", "resolver", "projectFile", "lockFile"],
                  "properties": {
                    "interpreter": { "const": "python3.14" },
                    "resolver": { "const": "uv" },
                    "projectFile": { "type": "string", "pattern": "^(?:(?!\\.{1,2}(?:/|$))[^/\\\\]+/)*pyproject\\.toml$" },
                    "lockFile": { "type": "string", "pattern": "^(?:(?!\\.{1,2}(?:/|$))[^/\\\\]+/)*uv\\.lock$" }
                  }
                },
                "seed": { "type": "string", "minLength": 1 },
                "iterations": { "type": "integer", "minimum": 1, "maximum": 1000000 }
              }
            }
          }
        }
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "scope", "approvedBy", "approvedAt", "expiresAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "operation": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "scope": { "type": "string", "minLength": 1 },
          "approvedBy": { "type": "string", "minLength": 1 },
          "approvedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}

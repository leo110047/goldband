        {
          "id": "land",
          "description": "Merge, deploy, and verify.",
          "runtime": "registered-only",
          "lifecycle": "experimental",
          "risk": "high",
          "safetyGates": [
            {
              "operation": "release/land",
              "mode": "land",
              "enforcement": "blocked-before-runtime",
              "owner": null,
              "authorization": "native-host-approval",
              "preconditions": [

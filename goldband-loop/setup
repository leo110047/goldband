#!/usr/bin/env bash
# goldband setup — build browser binary + register skills with Claude Code / Codex
set -e
umask 077  # Restrict new files to owner-only (0o600 files, 0o700 dirs)

SOURCE_GOLDBAND_DIR="$(cd "$(dirname "$0")" && pwd -P)"
MINIMUM_BUN_VERSION=$(sed -n 's/.*"bun"[[:space:]]*:[[:space:]]*">=\([0-9][0-9.]*\)".*/\1/p' "$SOURCE_GOLDBAND_DIR/package.json" | head -1)
[ -n "$MINIMUM_BUN_VERSION" ] || { echo "Error: goldband package is missing an exact engines.bun >=x.y.z contract." >&2; exit 1; }

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: bun is required but not installed." >&2
  echo "Install with checksum verification:" >&2
  echo "  BUN_VERSION=\"$MINIMUM_BUN_VERSION\"" >&2
  echo '  tmpfile=$(mktemp)' >&2
  echo '  curl -fsSL "https://bun.sh/install" -o "$tmpfile"' >&2
  echo '  echo "Verify checksum before running: shasum -a 256 $tmpfile"' >&2
  echo '  BUN_VERSION="$BUN_VERSION" bash "$tmpfile" && rm "$tmpfile"' >&2
  exit 1
fi

version_at_least() {
  local current="${1%%+*}"
  local minimum="${2%%+*}"
  local current_major current_minor current_patch
  local minimum_major minimum_minor minimum_patch
  IFS=. read -r current_major current_minor current_patch <<EOF
$current
EOF
  IFS=. read -r minimum_major minimum_minor minimum_patch <<EOF
$minimum
EOF
  case "$current_major$current_minor$current_patch$minimum_major$minimum_minor$minimum_patch" in
    *[!0-9]*) return 1 ;;
  esac
  [ "$current_major" -gt "$minimum_major" ] && return 0
  [ "$current_major" -lt "$minimum_major" ] && return 1
  [ "$current_minor" -gt "$minimum_minor" ] && return 0
  [ "$current_minor" -lt "$minimum_minor" ] && return 1
  [ "$current_patch" -ge "$minimum_patch" ]
}

CURRENT_BUN_VERSION=$(bun --version 2>/dev/null || true)
if ! version_at_least "$CURRENT_BUN_VERSION" "$MINIMUM_BUN_VERSION"; then
  echo "Error: Bun >=$MINIMUM_BUN_VERSION is required; found ${CURRENT_BUN_VERSION:-unknown}." >&2
  echo "Upgrade Bun before running setup: bun upgrade" >&2
  exit 1
fi

INSTALL_GOLDBAND_DIR="$(cd "$(dirname "$0")" && pwd)"
INSTALL_SKILLS_DIR="$(dirname "$INSTALL_GOLDBAND_DIR")"
BROWSE_BIN="$SOURCE_GOLDBAND_DIR/browse/dist/browse"
TASK_EMISSION_BIN="$SOURCE_GOLDBAND_DIR/bin/goldband-task-emission"
CODEX_SKILLS="$HOME/.codex/skills"
CODEX_GOLDBAND="$CODEX_SKILLS/goldband"
FACTORY_SKILLS="$HOME/.factory/skills"
FACTORY_GOLDBAND="$FACTORY_SKILLS/goldband"
OPENCODE_SKILLS="$HOME/.config/opencode/skills"
OPENCODE_GOLDBAND="$OPENCODE_SKILLS/goldband"

IS_WINDOWS=0
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) IS_WINDOWS=1 ;;
esac
if [ "${GOLDBAND_FORCE_COPY:-0}" = "1" ]; then
  IS_WINDOWS=1
fi

# ─── Symlink-or-copy helper ───────────────────────────────────
# On macOS/Linux: create a symlink (existing behavior).
# On Windows without Developer Mode (MSYS2/Git Bash): plain ln -snf silently
# creates a frozen file copy that doesn't refresh after `git pull`. We use
# explicit `cp -R` / `cp -f` so the user gets a real copy and the staleness
# is reportable (re-run ./setup after pull). Auto-detects file vs dir.
#
# INVARIANT: every symlink in this script MUST route through this helper.
# A raw ln call here will be caught by test/setup-windows-fallback.test.ts
# (the static-invariant assertion D7).
_link_or_copy() {
  local src="$1"
  local dst="$2"
  if [ "$IS_WINDOWS" -eq 1 ]; then
    rm -rf "$dst"
    # Unix `ln -snf` accepts a name-only or relative-path source even when the
    # target doesn't resolve from CWD (e.g. the goldband-open-goldband-browser skill points at
    # the sibling-relative "goldband/open-goldband-browser"). On Windows the
    # equivalent semantics don't exist — we'd need a real source on disk to
    # copy. Skip the alias quietly rather than aborting setup under `set -e`.
    if [ ! -e "$src" ]; then
      return 0
    fi
    if [ -d "$src" ]; then
      cp -R "$src" "$dst"
    else
      cp -f "$src" "$dst"
    fi
  else
    ln -snf "$src" "$dst"
  fi
}

_WINDOWS_COPY_NOTE_PRINTED=0
_print_windows_copy_note_once() {
  if [ "$IS_WINDOWS" -eq 1 ] && [ "$_WINDOWS_COPY_NOTE_PRINTED" -eq 0 ]; then
    echo "  note: Windows install uses file copies (no Developer Mode required). Re-run ./setup after every 'git pull' to refresh skill files."
    _WINDOWS_COPY_NOTE_PRINTED=1
  fi
}

_CODEX_MATERIALIZED_NOTE_PRINTED=0
_print_codex_materialized_note_once() {
  if [ "$_CODEX_MATERIALIZED_NOTE_PRINTED" -eq 0 ]; then
    echo "  note: Codex SKILL.md entrypoints are installed as file copies because Codex may skip symlinked SKILL.md files. Re-run ./setup after every 'git pull' to refresh them."
    _CODEX_MATERIALIZED_NOTE_PRINTED=1
  fi
}

_materialize_file_copy() {
  local src="$1"
  local dst="$2"
  local tmp="${dst}.tmp.$$"

  [ -f "$src" ] || return 0
  mkdir -p "$(dirname "$dst")"
  rm -f "$tmp"
  cp -f "$src" "$tmp"
  mv -f "$tmp" "$dst"
}

_materialize_codex_skill_file() {
  local src="$1"
  local dst="$2"

  _materialize_file_copy "$src" "$dst"
  _print_codex_materialized_note_once
}

materialize_work_map_runtime() {
  local runtime_root="$1"
  local target="$runtime_root/runtime"
  local temporary="$runtime_root/.work-map-runtime.tmp.$$"
  local required source

  rm -rf "$temporary"
  mkdir -p "$temporary/workflows" "$temporary/lib"

  for required in \
    workflows/work-map-cli.ts \
    workflows/work-map.ts \
    workflows/work-map-store.ts \
    workflows/work-map-runtime.ts \
    workflows/tracker-config.ts \
    workflows/tracker-runtime.ts \
    workflows/tracker-adapters/types.ts \
    workflows/tracker-adapters/projection.ts \
    workflows/tracker-adapters/sync-state.ts \
    workflows/tracker-adapters/import.ts \
    workflows/tracker-adapters/cli-adapter.ts \
    workflows/tracker-adapters/github.ts \
    workflows/tracker-adapters/gitlab.ts \
    workflows/types.ts \
    workflows/evidence.ts \
    lib/secret-content.ts \
    lib/state-root.ts
  do
    source="$SOURCE_GOLDBAND_DIR/$required"
    [ -f "$source" ] || {
      rm -rf "$temporary"
      echo "goldband setup failed: missing Work Map runtime source: $required" >&2
      exit 1
    }
    mkdir -p "$(dirname "$temporary/$required")"
    cp "$source" "$temporary/$required"
    if [ ! -f "$temporary/$required" ] || [ -L "$temporary/$required" ]; then
      rm -rf "$temporary"
      echo "goldband setup failed: invalid installed Work Map runtime file: $required" >&2
      exit 1
    fi
  done

  rm -rf "$target"
  mv "$temporary" "$target"
}

install_runtime_bin_directory() {
  local source_bin="$1"
  local target_bin="$2"
  local source_file name

  if [ -L "$target_bin" ]; then
    rm -f "$target_bin"
  else
    rm -rf "$target_bin"
  fi
  mkdir -p "$target_bin"
  for source_file in "$source_bin"/*; do
    [ -e "$source_file" ] || continue
    name="$(basename "$source_file")"
    case "$name" in
      goldband.ts)
        # Preserve the installed entry identity with its complete eager imports.
        bun build "$source_file" --target bun --outfile "$target_bin/$name" >/dev/null
        ;;
      goldband|goldband-work-verify|goldband-work-verify.ts)
        _materialize_file_copy "$source_file" "$target_bin/$name"
        ;;
      *)
        _link_or_copy "$source_file" "$target_bin/$name"
        ;;
    esac
  done
}

require_host_root_skill() {
  local host="$1"
  local root_skill="$2"

  if [ ! -f "$root_skill" ]; then
    echo "goldband setup failed: missing generated host skill for $host: $root_skill" >&2
    return 1
  fi
}

# ─── Quiet mode helper ────────────────────────────────────────
QUIET=0
log() { [ "$QUIET" -eq 0 ] && echo "$@" || true; }

cleanup_retired_source_host_skill_artifacts() {
  local host_root skills_root target target_name
  local inventory="$SOURCE_GOLDBAND_DIR/lib/retired-workflow-entry-names.txt"
  [ -f "$inventory" ] || {
    echo "goldband setup failed: missing retired workflow inventory: $inventory" >&2
    exit 1
  }
  validate_retired_workflow_inventory "$inventory"
  for host_root in .agents .factory .opencode; do
    skills_root="$SOURCE_GOLDBAND_DIR/$host_root/skills"
    [ -d "$skills_root" ] || continue
    for target in "$skills_root"/goldband-*; do
      [ -e "$target" ] || [ -L "$target" ] || continue
      target_name="$(basename "$target")"
      if ! retired_workflow_entry_name "$target_name" "$inventory" && \
          { [ -L "$target" ] || [ ! -f "$target/.goldband-managed-skill" ]; }; then
        continue
      fi
      rm -rf "$target"
      log "  cleaned retired source host skill: ${target#"$SOURCE_GOLDBAND_DIR"/}"
    done
  done
}

validate_retired_workflow_inventory() {
  local inventory="$1"
  local retired_name
  while IFS= read -r retired_name || [ -n "$retired_name" ]; do
    [ -n "$retired_name" ] || continue
    case "$retired_name" in
      *[!a-z0-9-]*|-*|*-|*--*)
        echo "goldband setup failed: invalid retired workflow entry name: $retired_name" >&2
        exit 1
        ;;
    esac
  done < "$inventory"
}

retired_workflow_entry_name() {
  local target_name="$1"
  local inventory="$2"
  local retired_name
  while IFS= read -r retired_name || [ -n "$retired_name" ]; do
    [ -n "$retired_name" ] || continue
    case "$target_name" in
      "$retired_name"|"goldband-$retired_name") return 0 ;;
    esac
  done < "$inventory"
  return 1
}

# ─── Parse flags ──────────────────────────────────────────────
HOST="claude"
WORKFLOW_PROFILE="${GOLDBAND_WORKFLOW_PROFILE:-standard}"
LOCAL_INSTALL=0
TEAM_MODE=0
NO_TEAM_MODE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --host) [ -z "$2" ] && echo "Missing value for --host (expected claude, codex, kiro, factory, opencode, openclaw, hermes, or auto)" >&2 && exit 1; HOST="$2"; shift 2 ;;
    --host=*) HOST="${1#--host=}"; shift ;;
    --profile) [ -z "$2" ] && echo "Missing value for --profile (expected standard)" >&2 && exit 1; WORKFLOW_PROFILE="$2"; shift 2 ;;
    --profile=*) WORKFLOW_PROFILE="${1#--profile=}"; shift ;;
    --local) LOCAL_INSTALL=1; shift ;;
    --team)    TEAM_MODE=1; shift ;;
    --no-team) NO_TEAM_MODE=1; shift ;;
    -q|--quiet) QUIET=1; shift ;;
    *) shift ;;
  esac
done

case "$HOST" in
  claude|codex|kiro|factory|opencode|auto) ;;
  openclaw)
    echo ""
    echo "OpenClaw integration uses a different model — OpenClaw spawns Claude Code"
    echo "sessions natively via ACP. goldband provides methodology artifacts, not a"
    echo "full skill installation."
    echo ""
    echo "To integrate goldband with OpenClaw:"
    echo "  1. Tell your OpenClaw agent: 'install goldband for openclaw'"
    echo "  2. See docs/OPENCLAW.md for the tracked integration assets"
    echo ""
    exit 0 ;;
  hermes)
    echo ""
    echo "Hermes integration uses the same model as OpenClaw — Hermes spawns"
    echo "Claude Code sessions, and goldband provides methodology artifacts."
    echo ""
    echo "To integrate goldband with Hermes:"
    echo "  1. Tell your Hermes agent: 'install goldband for hermes'"
    echo "  2. Use the shared goldband capability interface from the session"
    echo ""
    exit 0 ;;
  *) echo "Unknown --host value: $HOST (expected claude, codex, kiro, factory, opencode, openclaw, hermes, or auto)" >&2; exit 1 ;;
esac

case "$WORKFLOW_PROFILE" in
  full|slim)
    [ "$QUIET" -eq 1 ] || echo "warning: Goldband Loop workflow profile '$WORKFLOW_PROFILE' is deprecated; using standard." >&2
    WORKFLOW_PROFILE="standard"
    ;;
  standard) ;;
  *) echo "Unknown --profile value: $WORKFLOW_PROFILE (expected standard)" >&2; exit 1 ;;
esac

# --local: install to .claude/skills/ in the current working directory (deprecated)
if [ "$LOCAL_INSTALL" -eq 1 ]; then
  echo "Warning: --local is deprecated. Use global install + --team instead." >&2
  echo "  See: https://github.com/leo110047/goldband#team-mode" >&2
  if [ "$HOST" = "codex" ]; then
    echo "Error: --local is only supported for Claude Code (not Codex)." >&2
    exit 1
  fi
  INSTALL_SKILLS_DIR="$(pwd)/.claude/skills"
  mkdir -p "$INSTALL_SKILLS_DIR"
  HOST="claude"
  INSTALL_CODEX=0
fi

# For auto: detect which agents are installed
INSTALL_CLAUDE=0
INSTALL_CODEX=0
INSTALL_KIRO=0
INSTALL_FACTORY=0
INSTALL_OPENCODE=0
if [ "$HOST" = "auto" ]; then
  command -v claude >/dev/null 2>&1 && INSTALL_CLAUDE=1
  command -v codex >/dev/null 2>&1 && INSTALL_CODEX=1
  command -v kiro-cli >/dev/null 2>&1 && INSTALL_KIRO=1
  command -v droid >/dev/null 2>&1 && INSTALL_FACTORY=1
  command -v opencode >/dev/null 2>&1 && INSTALL_OPENCODE=1
  # If none found, default to claude
  if [ "$INSTALL_CLAUDE" -eq 0 ] && [ "$INSTALL_CODEX" -eq 0 ] && [ "$INSTALL_KIRO" -eq 0 ] && [ "$INSTALL_FACTORY" -eq 0 ] && [ "$INSTALL_OPENCODE" -eq 0 ]; then
    INSTALL_CLAUDE=1
  fi
elif [ "$HOST" = "claude" ]; then
  INSTALL_CLAUDE=1
elif [ "$HOST" = "codex" ]; then
  INSTALL_CODEX=1
elif [ "$HOST" = "kiro" ]; then
  INSTALL_KIRO=1
elif [ "$HOST" = "factory" ]; then
  INSTALL_FACTORY=1
elif [ "$HOST" = "opencode" ]; then
  INSTALL_OPENCODE=1
fi

cleanup_retired_source_host_skill_artifacts

migrate_direct_codex_install() {
  local goldband_dir="$1"
  local codex_goldband="$2"
  local migrated_dir="$HOME/.goldband/repos/goldband"

  [ "$goldband_dir" = "$codex_goldband" ] || return 0
  [ -L "$goldband_dir" ] && return 0

  mkdir -p "$(dirname "$migrated_dir")"
  if [ -e "$migrated_dir" ] && [ "$migrated_dir" != "$goldband_dir" ]; then
    echo "goldband setup failed: direct Codex install detected at $goldband_dir" >&2
    echo "A migrated repo already exists at $migrated_dir; move one of them aside and rerun setup." >&2
    exit 1
  fi

  log "Migrating direct Codex install to $migrated_dir to avoid duplicate skill discovery..."
  mv "$goldband_dir" "$migrated_dir"
  SOURCE_GOLDBAND_DIR="$migrated_dir"
  INSTALL_GOLDBAND_DIR="$migrated_dir"
  INSTALL_SKILLS_DIR="$(dirname "$INSTALL_GOLDBAND_DIR")"
  BROWSE_BIN="$SOURCE_GOLDBAND_DIR/browse/dist/browse"
  TASK_EMISSION_BIN="$SOURCE_GOLDBAND_DIR/bin/goldband-task-emission"
  [ -x "${TASK_EMISSION_BIN}.exe" ] && TASK_EMISSION_BIN="${TASK_EMISSION_BIN}.exe"
}

if [ "$INSTALL_CODEX" -eq 1 ]; then
  migrate_direct_codex_install "$SOURCE_GOLDBAND_DIR" "$CODEX_GOLDBAND"
fi

PLAYWRIGHT_LAST_ERROR_LOG=""

ensure_playwright_browser() {
  local log_file
  log_file="$(mktemp "${TMPDIR:-/tmp}/goldband-playwright-check.XXXXXX")"

  if [ "$IS_WINDOWS" -eq 1 ]; then
    # On Windows, Bun can't launch Chromium due to broken pipe handling
    # (oven-sh/bun#4253). Use Node.js to verify Chromium works instead.
    if (
      cd "$SOURCE_GOLDBAND_DIR"
      node -e "const { chromium } = require('playwright'); (async () => { const executablePath = process.env.GOLDBAND_CHROMIUM_PATH || undefined; const b = await chromium.launch(executablePath ? { executablePath } : {}); await b.close(); })()" 2>/dev/null
    ) >"$log_file" 2>&1; then
      rm -f "$log_file"
      PLAYWRIGHT_LAST_ERROR_LOG=""
      return 0
    fi
  else
    if (
      cd "$SOURCE_GOLDBAND_DIR"
      bun --eval 'import { chromium } from "playwright"; const executablePath = process.env.GOLDBAND_CHROMIUM_PATH || undefined; const browser = await chromium.launch(executablePath ? { executablePath } : {}); await browser.close();'
    ) >"$log_file" 2>&1; then
      rm -f "$log_file"
      PLAYWRIGHT_LAST_ERROR_LOG=""
      return 0
    fi
  fi

  PLAYWRIGHT_LAST_ERROR_LOG="$log_file"
  return 1
}

playwright_error_matches() {
  local pattern="$1"
  [ -n "$PLAYWRIGHT_LAST_ERROR_LOG" ] || return 1
  [ -f "$PLAYWRIGHT_LAST_ERROR_LOG" ] || return 1
  grep -Eiq "$pattern" "$PLAYWRIGHT_LAST_ERROR_LOG"
}

playwright_failure_indicates_environment_block() {
  playwright_error_matches 'Permission denied|Operation not permitted|MachPortRendezvousServer|bootstrap_check_in|EPERM|EACCES'
}

playwright_browser_cache_dir() {
  if [ -n "${PLAYWRIGHT_BROWSERS_PATH:-}" ]; then
    printf '%s\n' "$PLAYWRIGHT_BROWSERS_PATH"
    return 0
  fi

  case "$(uname -s)" in
    Darwin) printf '%s\n' "$HOME/Library/Caches/ms-playwright" ;;
    *) printf '%s\n' "${XDG_CACHE_HOME:-$HOME/.cache}/ms-playwright" ;;
  esac
}

playwright_browser_cache_writable() {
  local cache_dir
  local probe
  cache_dir="$(playwright_browser_cache_dir)"
  probe="$cache_dir/.goldband-write-test.$$"

  mkdir -p "$cache_dir" 2>/dev/null || return 1
  if : >"$probe" 2>/dev/null; then
    rm -f "$probe" 2>/dev/null || true
    return 0
  fi
  return 1
}

handle_playwright_unavailable_without_install() {
  local reason="$1"

  PLAYWRIGHT_READY=0
  if playwright_required; then
    echo "goldband setup failed: $reason" >&2
    echo "  Playwright Chromium install was not attempted because this environment cannot run or update the browser runtime safely." >&2
    echo "  To install without browser workflows: GOLDBAND_SKIP_PLAYWRIGHT=1 ./setup --host $HOST" >&2
    echo "  To make browser workflows optional in this environment: GOLDBAND_REQUIRE_PLAYWRIGHT=0 ./setup --host $HOST" >&2
    return 1
  fi

  echo "warning: $reason" >&2
  echo "warning: continuing without browser runtime because GOLDBAND_REQUIRE_PLAYWRIGHT=0" >&2
  return 0
}

prepare_bun_for_windows_compile() {
  BUN_CMD="bun"
  BUN_CMD_WAS_COPIED=0
  [ "$IS_WINDOWS" -eq 1 ] || return 0

  local bun_path
  bun_path="$(command -v bun 2>/dev/null || true)"
  case "$bun_path" in
    *[![:ascii:]]*)
      local bun_copy_dir="$SOURCE_GOLDBAND_DIR/.tmp-bun-bin"
      mkdir -p "$bun_copy_dir"
      cp -f "$bun_path" "$bun_copy_dir/bun.exe"
      BUN_CMD="$bun_copy_dir/bun.exe"
      BUN_CMD_WAS_COPIED=1
      ;;
  esac
}

bun_cmd() {
  "$BUN_CMD" "$@"
}

run_with_timeout() {
  local timeout_seconds="$1"
  shift

  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "${timeout_seconds}s" "$@"
  elif command -v timeout >/dev/null 2>&1; then
    timeout "${timeout_seconds}s" "$@"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c '
import subprocess
import sys

timeout = float(sys.argv[1])
command = sys.argv[2:]
try:
    raise SystemExit(subprocess.call(command, timeout=timeout))
except subprocess.TimeoutExpired:
    raise SystemExit(124)
' "$timeout_seconds" "$@"
  else
    echo "goldband setup warning: no timeout helper found; skipping timed command to avoid an unbounded hang" >&2
    return 124
  fi
}

playwright_required() {
  [ "${GOLDBAND_REQUIRE_PLAYWRIGHT:-1}" != "0" ]
}

cleanup_copied_bun() {
  if [ "${BUN_CMD_WAS_COPIED:-0}" -eq 1 ]; then
    rm -rf "$SOURCE_GOLDBAND_DIR/.tmp-bun-bin"
  fi
}

prepare_bun_for_windows_compile
trap cleanup_copied_bun EXIT

[ -x "${TASK_EMISSION_BIN}.exe" ] && TASK_EMISSION_BIN="${TASK_EMISSION_BIN}.exe"

# 1. Build runtime binaries if needed (smart rebuild: missing or stale outputs)
NEEDS_BUILD=0
if [ ! -x "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
elif [ ! -x "$TASK_EMISSION_BIN" ]; then
  NEEDS_BUILD=1
elif [ -n "$(find "$SOURCE_GOLDBAND_DIR/browse/src" -type f -newer "$BROWSE_BIN" -print -quit 2>/dev/null)" ]; then
  NEEDS_BUILD=1
elif [ "$SOURCE_GOLDBAND_DIR/scripts/task-emission-schema.ts" -nt "$TASK_EMISSION_BIN" ]; then
  NEEDS_BUILD=1
elif [ "$SOURCE_GOLDBAND_DIR/package.json" -nt "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
elif [ -f "$SOURCE_GOLDBAND_DIR/bun.lock" ] && [ "$SOURCE_GOLDBAND_DIR/bun.lock" -nt "$BROWSE_BIN" ]; then
  NEEDS_BUILD=1
fi
if [ "${GOLDBAND_SKIP_BUILD:-0}" = "1" ]; then
  NEEDS_BUILD=0
fi

if [ "$NEEDS_BUILD" -eq 1 ]; then
  log "Building runtime binaries..."
  (
    cd "$SOURCE_GOLDBAND_DIR"
    bun_cmd install --frozen-lockfile 2>/dev/null || bun_cmd install
    bun_cmd run build
  )
  # Safety net: write .version if build script didn't (e.g., git not available during build)
  if [ ! -f "$SOURCE_GOLDBAND_DIR/browse/dist/.version" ]; then
    git -C "$SOURCE_GOLDBAND_DIR" rev-parse HEAD > "$SOURCE_GOLDBAND_DIR/browse/dist/.version" 2>/dev/null || true
  fi

  # macOS Apple Silicon: ad-hoc codesign compiled binaries.
  # Bun's --compile can produce a corrupt or linker-only code signature that
  # macOS kills with SIGKILL (exit 137). The two-step remove+re-sign is
  # required because a naive `codesign -s - -f` fails when the existing
  # signature block is corrupt. This is idempotent and costs <1s.
  # See: https://github.com/leo110047/goldband/issues/997
  if [ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ]; then
    for _bin in browse/dist/browse browse/dist/find-browse design/dist/design make-pdf/dist/pdf bin/goldband-global-discover bin/goldband-task-emission; do
      _bin_path="$SOURCE_GOLDBAND_DIR/$_bin"
      [ -f "$_bin_path" ] && [ -x "$_bin_path" ] || continue
      codesign --remove-signature "$_bin_path" 2>/dev/null || true
      if ! codesign -s - -f "$_bin_path" 2>/dev/null; then
        log "warning: codesign failed for $_bin (binary may not run on Apple Silicon)"
      fi
    done
  fi

  # macOS: install coreutils for `gtimeout` (Codex hang protection in /codex + /autoplan).
  # macOS ships BSD `timeout`-less; Homebrew's coreutils installs GNU timeout as
  # `gtimeout` to avoid shadowing BSD utilities. The /codex and /autoplan skills
  # fall back to unwrapped codex invocations when neither is available — this
  # auto-install upgrades them to hang-protected where possible.
  # Skip entirely with GOLDBAND_SKIP_COREUTILS=1 (CI, managed machines, offline envs).
  if [ "$(uname -s)" = "Darwin" ] && [ "${GOLDBAND_SKIP_COREUTILS:-0}" != "1" ]; then
    if ! command -v gtimeout >/dev/null 2>&1 && ! command -v timeout >/dev/null 2>&1; then
      if command -v brew >/dev/null 2>&1; then
        log "Installing coreutils for Codex hang protection (set GOLDBAND_SKIP_COREUTILS=1 to skip)..."
        brew install coreutils >/dev/null 2>&1 || log "warning: brew install coreutils failed; /codex will run without hang protection"
      else
        log "warning: Homebrew not found. /codex will run without hang protection. Install coreutils manually or set GOLDBAND_SKIP_COREUTILS=1."
      fi
    fi
  fi
fi

if [ ! -x "$BROWSE_BIN" ]; then
  echo "goldband setup failed: browse binary missing at $BROWSE_BIN" >&2
  exit 1
fi
if [ ! -x "$SOURCE_GOLDBAND_DIR/bin/goldband-task-emission" ] && [ ! -x "$SOURCE_GOLDBAND_DIR/bin/goldband-task-emission.exe" ]; then
  echo "goldband setup failed: task emission binary missing" >&2
  exit 1
fi

# 2. Ensure Playwright's Chromium is available
PLAYWRIGHT_READY=1
if [ "${GOLDBAND_SKIP_PLAYWRIGHT:-0}" = "1" ]; then
  PLAYWRIGHT_READY=0
  log "Skipping Playwright Chromium install (GOLDBAND_SKIP_PLAYWRIGHT=1). Browser workflows will be unavailable until Chromium is installed."
elif ! ensure_playwright_browser; then
  if playwright_failure_indicates_environment_block; then
    handle_playwright_unavailable_without_install "Playwright Chromium launch was blocked by the current environment or sandbox" || exit 1
  elif ! playwright_browser_cache_writable; then
    handle_playwright_unavailable_without_install "Playwright browser cache is not writable: $(playwright_browser_cache_dir)" || exit 1
  else
    echo "Installing Playwright Chromium..."
    PLAYWRIGHT_INSTALL_TIMEOUT_SECONDS="${GOLDBAND_PLAYWRIGHT_INSTALL_TIMEOUT_SECONDS:-300}"
    (
      cd "$SOURCE_GOLDBAND_DIR"
      run_with_timeout "$PLAYWRIGHT_INSTALL_TIMEOUT_SECONDS" bunx playwright install chromium
    ) || {
      if playwright_required; then
        echo "goldband setup failed: Playwright Chromium install did not finish successfully within ${PLAYWRIGHT_INSTALL_TIMEOUT_SECONDS}s" >&2
        echo "  Re-run manually for details: cd $SOURCE_GOLDBAND_DIR && bunx playwright install chromium" >&2
        echo "  Or increase the timeout: GOLDBAND_PLAYWRIGHT_INSTALL_TIMEOUT_SECONDS=600 ./setup --host $HOST" >&2
        echo "  To install without browser workflows: GOLDBAND_SKIP_PLAYWRIGHT=1 ./setup --host $HOST" >&2
        exit 1
      fi
      PLAYWRIGHT_READY=0
      echo "warning: Playwright Chromium install did not finish successfully within ${PLAYWRIGHT_INSTALL_TIMEOUT_SECONDS}s; continuing without browser runtime" >&2
      echo "  Re-run manually for details: cd $SOURCE_GOLDBAND_DIR && bunx playwright install chromium" >&2
    }
  fi

  if [ "$PLAYWRIGHT_READY" -eq 1 ] && [ "$IS_WINDOWS" -eq 1 ]; then
    # On Windows, Node.js launches Chromium (not Bun — see oven-sh/bun#4253).
    # Ensure playwright is importable by Node from the goldband directory.
    if ! command -v node >/dev/null 2>&1; then
      echo "goldband setup failed: Node.js is required on Windows (Bun cannot launch Chromium due to a pipe bug)" >&2
      echo "  Install Node.js: https://nodejs.org/" >&2
      exit 1
    fi
    echo "Windows detected — verifying Node.js can load Playwright..."
    (
      cd "$SOURCE_GOLDBAND_DIR"
      # Bun's node_modules already has playwright; verify Node can require it
      node -e "require('playwright')" 2>/dev/null || npm install --no-save playwright
      # @ngrok/ngrok is externalized in server-node.mjs and resolved at runtime.
      # Verify the platform-specific native binary is installed so /pair-agent
      # tunnels don't fail later with a cryptic module-not-found error.
      node -e "require('@ngrok/ngrok')" 2>/dev/null || npm install --no-save @ngrok/ngrok
    )
  fi
fi

if [ "$PLAYWRIGHT_READY" -eq 1 ] && ! ensure_playwright_browser; then
  if [ "$IS_WINDOWS" -eq 1 ]; then
    echo "goldband setup failed: Playwright Chromium could not be launched via Node.js" >&2
    echo "  This is a known issue with Bun on Windows (oven-sh/bun#4253)." >&2
    echo "  Ensure Node.js is installed and 'node -e \"require('playwright')\"' works." >&2
  else
    echo "goldband setup failed: Playwright Chromium could not be launched" >&2
  fi
  if playwright_required; then
    exit 1
  fi
  echo "warning: continuing without browser runtime; run 'cd $SOURCE_GOLDBAND_DIR && bunx playwright install chromium' to enable browser workflows" >&2
fi

# 3. Ensure ~/.goldband global state directory exists
mkdir -p "$HOME/.goldband/projects"

# Older installs created ~/.claude/skills/_goldband-command as a second
# `name: goldband` entrypoint. The user-facing /goldband surface is now the
# slash command selector in ~/.claude/commands/goldband.md, so remove the
# legacy alias when it is clearly goldband-managed.
cleanup_claude_root_skill_alias() {
  local goldband_dir="$1"
  local skills_dir="$2"
  local target="$skills_dir/_goldband-command"

  [ -e "$target" ] || [ -L "$target" ] || return 0
  if [ -f "$target/.goldband-managed-skill" ]; then
    rm -rf "$target"
    echo "  removed legacy root skill alias: _goldband-command"
    return 0
  fi
  if [ -d "$target" ] && [ -L "$target/SKILL.md" ] && symlink_target_under_dir "$target/SKILL.md" "$goldband_dir"; then
    rm -rf "$target"
    echo "  removed legacy root skill alias: _goldband-command"
  fi
}

path_under_dir() {
  local candidate="$1"
  local base="$2"
  local candidate_real base_real
  candidate_real="$(cd "$candidate" 2>/dev/null && pwd -P)" || return 1
  base_real="$(cd "$base" 2>/dev/null && pwd -P)" || return 1
  case "$candidate_real" in
    "$base_real"|"$base_real"/*) return 0 ;;
    *) return 1 ;;
  esac
}

same_dir_path() {
  local left="$1"
  local right="$2"
  local left_real right_real
  left_real="$(cd "$left" 2>/dev/null && pwd -P)" || return 1
  right_real="$(cd "$right" 2>/dev/null && pwd -P)" || return 1
  [ "$left_real" = "$right_real" ]
}

workflow_managed_manifest_path() {
  local host="$1"
  printf '%s\n' "$HOME/.goldband/state/workflow-managed-$host"
}

symlink_target_under_dir() {
  local candidate="$1"
  local base="$2"
  local link_dest candidate_dir resolved_dir resolved_path base_real
  link_dest="$(readlink "$candidate" 2>/dev/null || true)"
  [ -n "$link_dest" ] || return 1
  case "$link_dest" in
    /*) resolved_path="$link_dest" ;;
    *)
      candidate_dir="$(dirname "$candidate")"
      resolved_path="$candidate_dir/$link_dest"
      ;;
  esac
  resolved_dir="$(dirname "$resolved_path")"
  resolved_path="$(cd "$resolved_dir" 2>/dev/null && pwd -P)/$(basename "$resolved_path")" || return 1
  base_real="$(cd "$base" 2>/dev/null && pwd -P)" || return 1
  case "$resolved_path" in
    "$base_real"|"$base_real"/*) return 0 ;;
    *) return 1 ;;
  esac
}

cleanup_manifest_entries_for_standard() {
  local host="$1"
  local skills_dir="$2"
  local manifest
  local removed=()
  local target

  manifest="$(workflow_managed_manifest_path "$host")"
  [ -f "$manifest" ] || return 0

  while IFS= read -r target; do
    [ -n "$target" ] || continue
    [ -e "$target" ] || [ -L "$target" ] || continue
    path_under_dir "$target" "$skills_dir" || continue
    rm -rf "$target"
    removed+=("$(basename "$target")")
  done < "$manifest"

  : > "$manifest"
  if [ ${#removed[@]} -gt 0 ]; then
    echo "  cleaned manifest-managed legacy full-profile entries: ${removed[*]}"
  fi
}

cleanup_legacy_full_workflow_entries_for_standard() {
  local skills_dir="$2"
  local host="${4:-}"
  local removed=()
  local skill_name target
  local inventory="$SOURCE_GOLDBAND_DIR/lib/retired-workflow-entry-names.txt"

  if [ -n "$host" ]; then
    cleanup_manifest_entries_for_standard "$host" "$skills_dir"
  fi

  # The prompt sources are intentionally gone, so keep only this migration
  # inventory to identify names owned by pre-thin-contract installers.
  [ -f "$inventory" ] || {
    echo "goldband setup failed: missing retired workflow inventory: $inventory" >&2
    exit 1
  }
  validate_retired_workflow_inventory "$inventory"
  while IFS= read -r skill_name || [ -n "$skill_name" ]; do
    [ -n "$skill_name" ] || continue
    for target in "$skills_dir/$skill_name" "$skills_dir/goldband-$skill_name"; do
      [ -e "$target" ] || [ -L "$target" ] || continue
      rm -rf "$target"
      removed+=("$(basename "$target")")
    done
  done < "$inventory"

  if [ ${#removed[@]} -gt 0 ]; then
    echo "  cleaned legacy full-profile entries: ${removed[*]}"
  fi
}

create_internal_workflow_docs() {
  local runtime_root="$1"
  local workflow_root="$runtime_root/workflows"
  local capability_contract="$SOURCE_GOLDBAND_DIR/generated/capability-actions.json"
  local linked=()
  local capability action contract_path contract_file target manual_id manual_source

  # A source tree may itself be the selected skills/goldband runtime. Its
  # workflows/ directory owns executable TypeScript and must never be replaced
  # by generated Markdown. The dedicated helper owns and tests that destructive
  # boundary; materialized runtime roots are rebuilt cleanly.
  bash "$SOURCE_GOLDBAND_DIR/scripts/prepare-internal-workflow-root.sh" \
    "$runtime_root" "$SOURCE_GOLDBAND_DIR"
  [ -f "$capability_contract" ] || { echo "goldband setup failed: missing generated capability contract: $capability_contract" >&2; exit 1; }

  while IFS=$'\t' read -r capability action contract_path; do
    [ -n "$contract_path" ] || { echo "goldband setup failed: missing contractPath for $capability/$action" >&2; exit 1; }
    contract_file="$SOURCE_GOLDBAND_DIR/$contract_path"
    [ -f "$contract_file" ] || { echo "goldband setup failed: missing workflow contract for $capability/$action: $contract_file" >&2; exit 1; }
    mkdir -p "$workflow_root/$capability"
    target="$workflow_root/$capability/$action.workflow.md"
    _link_or_copy "$contract_file" "$target"
    linked+=("$capability/$action")
  done < <(node -e 'const c=require(process.argv[1]); for (const a of c.actions) console.log([a.capability,a.action,a.contractPath].join("\t"))' "$capability_contract")

  mkdir -p "$runtime_root/manuals"
  while IFS=$'\t' read -r manual_id manual_source; do
    [ -n "$manual_id" ] && [ -n "$manual_source" ] || { echo "goldband setup failed: invalid manual contract" >&2; exit 1; }
    [ -f "$SOURCE_GOLDBAND_DIR/$manual_source" ] || { echo "goldband setup failed: missing manual source: $manual_source" >&2; exit 1; }
    _link_or_copy "$SOURCE_GOLDBAND_DIR/$manual_source" "$runtime_root/manuals/$manual_id.md"
  done < <(node -e 'const c=require(process.argv[1]); for (const m of c.manuals || []) console.log([m.id,m.source].join("\t"))' "$capability_contract")

  if [ ${#linked[@]} -gt 0 ]; then
    echo "  internal workflows: ${#linked[@]}"
    _print_windows_copy_note_once
  fi

  # A copied minimal runtime does not contain the executable TypeScript
  # workflow owner. Keep an explicit source pointer so bin/goldband can launch
  # the typed runtime without guessing or depending on symlink support.
  if ! same_dir_path "$runtime_root" "$SOURCE_GOLDBAND_DIR"; then
    printf '%s\n' "$SOURCE_GOLDBAND_DIR" > "$runtime_root/.installed-source"
    materialize_work_map_runtime "$runtime_root"
  fi
}

install_review_authoring_assets() {
  local goldband_dir="$1"
  local runtime_root="$2"
  local repo_root guide_source example_source manifest_schema_source behavior_schema_source
  repo_root="$(cd "$goldband_dir/.." && pwd -P)"

  guide_source="$repo_root/docs/review-evidence-manifest.md"
  example_source="$repo_root/examples/review-evidence/minimal-local-gate.json"
  manifest_schema_source="$repo_root/schemas/review-evidence-manifest.schema.json"
  behavior_schema_source="$repo_root/schemas/review-behavior-matrix.schema.json"
  [ -f "$guide_source" ] || guide_source="$goldband_dir/review/review-evidence-manifest.md"
  [ -f "$example_source" ] || example_source="$goldband_dir/review/examples/minimal-local-gate.json"
  [ -f "$manifest_schema_source" ] || manifest_schema_source="$goldband_dir/review/schemas/review-evidence-manifest.schema.json"
  [ -f "$behavior_schema_source" ] || behavior_schema_source="$goldband_dir/review/schemas/review-behavior-matrix.schema.json"

  [ -f "$guide_source" ] || {
    echo "goldband setup failed: missing review manifest authoring guide" >&2
    exit 1
  }
  [ -f "$example_source" ] || {
    echo "goldband setup failed: missing review manifest example" >&2
    exit 1
  }
  [ -f "$manifest_schema_source" ] || {
    echo "goldband setup failed: missing review manifest schema" >&2
    exit 1
  }
  [ -f "$behavior_schema_source" ] || {
    echo "goldband setup failed: missing review behavior schema" >&2
    exit 1
  }

  mkdir -p "$runtime_root/review/examples" "$runtime_root/review/schemas"
  _link_or_copy \
    "$guide_source" \
    "$runtime_root/review/review-evidence-manifest.md"
  _link_or_copy \
    "$example_source" \
    "$runtime_root/review/examples/minimal-local-gate.json"
  _link_or_copy \
    "$manifest_schema_source" \
    "$runtime_root/review/schemas/review-evidence-manifest.schema.json"
  _link_or_copy \
    "$behavior_schema_source" \
    "$runtime_root/review/schemas/review-behavior-matrix.schema.json"
}

# ─── Helper: create a minimal ~/.codex/skills/goldband runtime root ───────────
# Codex scans ~/.codex/skills recursively. Exposing the whole repo here causes
# duplicate skills when old per-workflow entries remain discoverable. Keep this
# directory limited to runtime assets, thin contracts, and the root skill.
create_codex_runtime_root() {
  local goldband_dir="$1"
  local codex_goldband="$2"
  local root_skill="$goldband_dir/generated/host-skills/codex.SKILL.md"

  require_host_root_skill "codex" "$root_skill"

  if [ -L "$codex_goldband" ]; then
    rm -f "$codex_goldband"
  elif [ -d "$codex_goldband" ] && [ "$codex_goldband" != "$goldband_dir" ]; then
    # Old direct installs left a real directory here with stale source skills.
    # Remove it so we start fresh with only the minimal runtime assets.
    rm -rf "$codex_goldband"
  fi

  mkdir -p "$codex_goldband" "$codex_goldband/browse" "$codex_goldband/review" "$codex_goldband/workflows"

  # Codex discovers skills from SKILL.md files. Keep the root selector as a
  # materialized file; symlinked SKILL.md files can be skipped by the scanner.
  _materialize_codex_skill_file "$root_skill" "$codex_goldband/SKILL.md"
  if [ -d "$goldband_dir/bin" ]; then
    install_runtime_bin_directory "$goldband_dir/bin" "$codex_goldband/bin"
  fi
  if [ -d "$goldband_dir/lib" ]; then
    _link_or_copy "$goldband_dir/lib" "$codex_goldband/lib"
  fi
  if [ -d "$goldband_dir/cross-review" ]; then
    _link_or_copy "$goldband_dir/cross-review" "$codex_goldband/cross-review"
  fi
  if [ -d "$goldband_dir/browse/dist" ]; then
    _link_or_copy "$goldband_dir/browse/dist" "$codex_goldband/browse/dist"
  fi
  if [ -d "$goldband_dir/browse/bin" ]; then
    _link_or_copy "$goldband_dir/browse/bin" "$codex_goldband/browse/bin"
  fi
  # Review runtime assets (individual files, NOT the whole review/ dir which has SKILL.md)
  for f in shared-rubric.md findings-schema.md checklist.md evidence-omission.md design-checklist.md greptile-triage.md TODOS-format.md; do
    if [ -f "$goldband_dir/review/$f" ]; then
      _link_or_copy "$goldband_dir/review/$f" "$codex_goldband/review/$f"
    fi
  done
  install_review_authoring_assets "$goldband_dir" "$codex_goldband"
  # ETHOS.md — referenced by "Search Before Building" in all skill preambles
  if [ -f "$goldband_dir/ETHOS.md" ]; then
    _link_or_copy "$goldband_dir/ETHOS.md" "$codex_goldband/ETHOS.md"
  fi
  create_internal_workflow_docs "$codex_goldband"
}

install_codex_trusted_workflow_launcher() {
  local codex_goldband="$1"
  local bun_path codex_path trusted_root rule_file marker_file
  bun_path="$(command -v bun)"
  codex_path="$(command -v codex 2>/dev/null || true)"
  case "$bun_path" in
    /*) ;;
    *)
      echo "goldband setup failed: Codex trusted workflow launcher requires an absolute Bun path; found: $bun_path" >&2
      return 1
      ;;
  esac
  case "$codex_path" in
    /*) ;;
    *)
      echo "goldband setup failed: Codex trusted workflow launcher requires an absolute Codex CLI path; found: ${codex_path:-missing}" >&2
      return 1
      ;;
  esac

  trusted_root="$HOME/.codex/goldband/workflow-runtime"
  rule_file="$HOME/.codex/rules/goldband-workflows.rules"
  marker_file="$codex_goldband/.workflow-launcher.json"
  bun "$SOURCE_GOLDBAND_DIR/scripts/install-codex-review-launcher.ts" \
    --source-root "$SOURCE_GOLDBAND_DIR" \
    --runtime-root "$trusted_root" \
    --rule-file "$rule_file" \
    --marker-file "$marker_file" \
    --bun-path "$bun_path" \
    --codex-path "$codex_path" \
    --browser-path "$BROWSE_BIN"

  rm -rf "$HOME/.codex/goldband/review-runtime"
  rm -f "$HOME/.codex/rules/goldband-review.rules"
  rm -f "$codex_goldband/.review-launcher.json"
}

create_claude_runtime_root() {
  local goldband_dir="$1"
  local claude_goldband="$2"
  local root_skill="$goldband_dir/generated/host-skills/claude.SKILL.md"

  require_host_root_skill "claude" "$root_skill"

  if [ ! -L "$claude_goldband" ] && same_dir_path "$goldband_dir" "$claude_goldband"; then
    mkdir -p "$claude_goldband/workflows"
    create_internal_workflow_docs "$claude_goldband"
    bun "$SOURCE_GOLDBAND_DIR/scripts/provision-review-receipt-authority.ts" \
      --runtime-root "$claude_goldband" \
      --authority-root "$HOME/.goldband/review-authority/claude"
    return 0
  fi

  if [ -L "$claude_goldband" ]; then
    rm -f "$claude_goldband"
  elif [ -d "$claude_goldband" ] && [ "$claude_goldband" != "$goldband_dir" ]; then
    if [ -f "$claude_goldband/.installed-version" ] || [ -x "$claude_goldband/bin/goldband-config" ]; then
      rm -rf "$claude_goldband"
    else
      echo "goldband setup failed: refusing to replace non-goldband Claude runtime at $claude_goldband" >&2
      exit 1
    fi
  fi

  mkdir -p "$claude_goldband" "$claude_goldband/browse" "$claude_goldband/review" "$claude_goldband/workflows"

  _link_or_copy "$root_skill" "$claude_goldband/SKILL.md"
  if [ -d "$goldband_dir/bin" ]; then
    install_runtime_bin_directory "$goldband_dir/bin" "$claude_goldband/bin"
  fi
  if [ -d "$goldband_dir/lib" ]; then
    _link_or_copy "$goldband_dir/lib" "$claude_goldband/lib"
  fi
  if [ -d "$goldband_dir/cross-review" ]; then
    _link_or_copy "$goldband_dir/cross-review" "$claude_goldband/cross-review"
  fi
  if [ -d "$goldband_dir/browse/dist" ]; then
    _link_or_copy "$goldband_dir/browse/dist" "$claude_goldband/browse/dist"
  fi
  if [ -d "$goldband_dir/browse/bin" ]; then
    _link_or_copy "$goldband_dir/browse/bin" "$claude_goldband/browse/bin"
  fi
  for f in shared-rubric.md findings-schema.md checklist.md evidence-omission.md design-checklist.md greptile-triage.md TODOS-format.md; do
    if [ -f "$goldband_dir/review/$f" ]; then
      _link_or_copy "$goldband_dir/review/$f" "$claude_goldband/review/$f"
    fi
  done
  install_review_authoring_assets "$goldband_dir" "$claude_goldband"
  if [ -f "$goldband_dir/ETHOS.md" ]; then
    _link_or_copy "$goldband_dir/ETHOS.md" "$claude_goldband/ETHOS.md"
  fi
  create_internal_workflow_docs "$claude_goldband"
  bun "$SOURCE_GOLDBAND_DIR/scripts/provision-review-receipt-authority.ts" \
    --runtime-root "$claude_goldband" \
    --authority-root "$HOME/.goldband/review-authority/claude"
}


#!/usr/bin/env bash
# goldband-team-init — generate repo-level bootstrap files for team mode
#
# Usage:
#   goldband-team-init optional   # gentle CLAUDE.md suggestion, one-time offer
#   goldband-team-init required   # CLAUDE.md enforcement + PreToolUse hook
#
# Run from the root of your team's repo (not from the goldband directory).

set -euo pipefail

MODE="${1:-}"

if [ "$MODE" != "optional" ] && [ "$MODE" != "required" ]; then
  echo "Usage: goldband-team-init {optional|required}" >&2
  echo "" >&2
  echo "  optional  — suggest goldband install once per developer (gentle)" >&2
  echo "  required  — enforce goldband install, block work without it" >&2
  exit 1
fi

# Must be in a git repo
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  echo "Error: not in a git repository. Run from your project root." >&2
  exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
CLAUDE_MD="$REPO_ROOT/CLAUDE.md"
GENERATED=()

# ── Migrate vendored copy if present ──────────────────────────

if [ -d "$REPO_ROOT/.claude/skills/goldband" ] && [ ! -L "$REPO_ROOT/.claude/skills/goldband" ]; then
  if [ -f "$REPO_ROOT/.claude/skills/goldband/VERSION" ] || [ -d "$REPO_ROOT/.claude/skills/goldband/.git" ]; then
    echo "  Found vendored goldband copy at $REPO_ROOT/.claude/skills/goldband"
    echo "  Team mode uses the global install — removing vendored copy..."
    ( cd "$REPO_ROOT" && git rm -r --cached .claude/skills/goldband/ 2>/dev/null ) || true
    if [ -f "$REPO_ROOT/.gitignore" ]; then
      if ! grep -qF '.claude/skills/goldband/' "$REPO_ROOT/.gitignore" 2>/dev/null; then
        echo '.claude/skills/goldband/' >> "$REPO_ROOT/.gitignore"
      fi
    else
      echo '.claude/skills/goldband/' > "$REPO_ROOT/.gitignore"
    fi
    rm -rf "$REPO_ROOT/.claude/skills/goldband"
    GENERATED+=(".gitignore")
    echo "  Removed vendored copy and added .claude/skills/goldband/ to .gitignore"
  fi
fi

# ── CLAUDE.md snippet ──────────────────────────────────────────

if [ "$MODE" = "optional" ]; then
  SNIPPET='## goldband (recommended)

This project uses [goldband](https://github.com/leo110047/goldband) for AI-assisted workflows.
Install it for the best experience:

```bash
git clone --depth 1 https://github.com/leo110047/goldband.git ~/.claude/skills/goldband
cd ~/.claude/skills/goldband && ./setup --team
```

Use the `$goldband <capability> <action>` interface after install.
Use ~/.claude/skills/goldband/... for goldband file paths.'
else
  SNIPPET='## goldband (REQUIRED — global install)

**Before doing ANY work, verify goldband is installed:**

```bash
test -d ~/.claude/skills/goldband/bin && echo "GOLDBAND_OK" || echo "GOLDBAND_MISSING"
```

If GOLDBAND_MISSING: STOP. Do not proceed. Tell the user:

> goldband is required for all AI-assisted work in this repo.
> Install it:
> ```bash
> git clone --depth 1 https://github.com/leo110047/goldband.git ~/.claude/skills/goldband
> cd ~/.claude/skills/goldband && ./setup --team
> ```
> Then restart your AI coding tool.

Do not skip skills, ignore goldband errors, or work around missing goldband.

Using goldband: After install, invoke capabilities through `$goldband <capability> <action>`.
Use the browser capability for web browsing.
Use ~/.claude/skills/goldband/... for goldband file paths (the global path).'
fi

# Check if CLAUDE.md already has a goldband section
if [ -f "$CLAUDE_MD" ] && grep -q "## goldband" "$CLAUDE_MD" 2>/dev/null; then
  echo "CLAUDE.md already has a goldband section. Skipping CLAUDE.md update."
  echo "  To replace it, remove the existing ## goldband section and re-run."
else
  if [ -f "$CLAUDE_MD" ]; then
    echo "" >> "$CLAUDE_MD"
  fi
  echo "$SNIPPET" >> "$CLAUDE_MD"
  GENERATED+=("CLAUDE.md")
  echo "  + CLAUDE.md — added goldband $MODE section"
fi

# ── Required mode: enforcement hook ────────────────────────────

if [ "$MODE" = "required" ]; then
  HOOKS_DIR="$REPO_ROOT/.claude/hooks"
  SETTINGS="$REPO_ROOT/.claude/settings.json"

  # Create enforcement hook script
  mkdir -p "$HOOKS_DIR"
  cat > "$HOOKS_DIR/check-goldband.sh" << 'HOOK_EOF'
#!/bin/bash
# Block skill usage when goldband is not installed globally.

if [ ! -d "$HOME/.claude/skills/goldband/bin" ]; then
  cat >&2 <<'MSG'
BLOCKED: goldband is not installed globally.

goldband is required for AI-assisted work in this repo.

Install it:
  git clone --depth 1 https://github.com/leo110047/goldband.git ~/.claude/skills/goldband
  cd ~/.claude/skills/goldband && ./setup --team

Then restart your AI coding tool.
MSG
  echo '{"permissionDecision":"deny","message":"goldband is required but not installed. See stderr for install instructions."}'
  exit 0
fi

echo '{}'
HOOK_EOF
  chmod +x "$HOOKS_DIR/check-goldband.sh"
  GENERATED+=(".claude/hooks/check-goldband.sh")
  echo "  + .claude/hooks/check-goldband.sh — enforcement hook"

  # Add hook to project-level settings.json
  if command -v bun >/dev/null 2>&1; then
    GOLDBAND_SETTINGS_PATH="$SETTINGS" bun -e "
      const fs = require('fs');
      const settingsPath = process.env.GOLDBAND_SETTINGS_PATH;

      let settings = {};
      try { settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8')); } catch {}

      if (!settings.hooks) settings.hooks = {};
      if (!settings.hooks.PreToolUse) settings.hooks.PreToolUse = [];

      // Dedup
      const exists = settings.hooks.PreToolUse.some(entry =>
        entry.matcher === 'Skill' &&
        entry.hooks && entry.hooks.some(h => h.command && h.command.includes('check-goldband'))
      );

      if (!exists) {
        settings.hooks.PreToolUse.push({
          matcher: 'Skill',
          hooks: [{
            type: 'command',
            command: '\"\$CLAUDE_PROJECT_DIR/.claude/hooks/check-goldband.sh\"'
          }]
        });
      }

      const tmp = settingsPath + '.tmp';
      fs.writeFileSync(tmp, JSON.stringify(settings, null, 2) + '\n');
      fs.renameSync(tmp, settingsPath);
    " 2>/dev/null
    GENERATED+=(".claude/settings.json")
    echo "  + .claude/settings.json — PreToolUse hook registered"
  else
    echo "  ! bun not found — manually add the PreToolUse hook to .claude/settings.json"
  fi
fi

# ── Summary ────────────────────────────────────────────────────

echo ""
echo "Team mode ($MODE) initialized."
echo ""
if [ ${#GENERATED[@]} -gt 0 ]; then
  echo "Commit the generated files:"
  echo "  git add ${GENERATED[*]}"
  echo "  git commit -m \"chore: require goldband for AI-assisted work\""
fi
echo ""
echo "Each developer then runs:"
echo "  git clone --depth 1 https://github.com/leo110047/goldband.git ~/.claude/skills/goldband"
echo "  cd ~/.claude/skills/goldband && ./setup --team"

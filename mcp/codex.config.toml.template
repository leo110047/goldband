# Copy selected tables into ~/.codex/config.toml only after validating the server
# with MCP Inspector. Token-backed servers are disabled by omission; do not paste
# secrets into this repository.

[mcp_servers.goldband]
command = "node"
args = ["/path/to/goldband/mcp/server/dist/index.js"]
enabled = false

[mcp_servers.github]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]
env_vars = ["GITHUB_PERSONAL_ACCESS_TOKEN"]
enabled = false

[mcp_servers.sentry]
command = "npx"
args = ["-y", "@sentry/mcp-server"]
env_vars = ["SENTRY_AUTH_TOKEN"]
enabled = false

[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp"]
enabled = false

[mcp_servers.playwright]
command = "npx"
args = [
  "-y",
  "@playwright/mcp@0.0.83",
  "--isolated",
  "--allowed-origins=http://localhost:*;http://127.0.0.1:*",
  "--output-dir=/path/to/goldband-home/playwright-mcp",
  "--output-max-size=5242880",
]
enabled = false

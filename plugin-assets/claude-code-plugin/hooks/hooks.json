{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooks/skill-activation-suggestions.js\""
          }
        ],
        "description": "Prompt-time skill suggestions + prompt-trigger telemetry"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Unified router (blocking policies: careful-mode/freeze-mode/secrets/dev-server/doc-file)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Unified router (context monitor + console warnings)"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooks/post-edit-worker.js\" --task format",
            "async": true
          }
        ],
        "description": "Native async format worker with debounce"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooks/post-edit-worker.js\" --task typecheck",
            "async": true
          }
        ],
        "description": "Native async typecheck worker with debounce"
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Actionable Goldband review failure guidance"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Unified router (cross-review gate + mode cleanup)"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "general-purpose",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Review the subagent's final output. Check: (1) Did it claim completion? If so, does the output contain concrete evidence (file paths, test results, command output) — not just 'Done!' or 'All set!'? (2) Are there red flags like 'should work', 'probably', or missing verification steps? If the output lacks evidence of completion, respond with a brief note about what verification is missing. If the output contains proper evidence, respond with 'LGTM'.",
            "timeout": 30
          }
        ],
        "description": "Lightweight spec review for general-purpose subagent output"
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooks/hook-router.js\""
          }
        ],
        "description": "Unified router notification handling"
      }
    ]
  }
}
